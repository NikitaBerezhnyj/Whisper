label shop_scene:
    scene shop with fade
    
    "Магазин зустрічає мене яскравим світлом і гулом холодильних вітрин."
    "Беру кошик і крокую між рядами."
    
    "Молоко, хліб, сир — стандартний набір, який беру, коли не хочу думати про їжу."
    
    gg "Треба ще щось?"
    
    whisper "Візьми печиво — вже тричі на нього дивишся."
    
    "Я зупиняюся біля полиці."
    
    gg "Добре, візьму."
    
    "Кошик майже повний. Час до каси."
    "Підходжу до єдиної відкритої — там молода дівчина з акуратно зібраним волоссям."
    
    show cashier with dissolve
    
    cashier "Добрий день!"
    whisper "Добрий!"
    
    "Вона швидко сканує товари, пальці рухаються впевнено."
    
    "Гарна зачіска… їй дуже пасує."
    
    cashier "Пакет потрібен?"
    whisper "Так, будь ласка."
    
    cashier "Бонусна картка є?"
    whisper "Ні."
    
    "Вона рахує суму. Я дістаю гроші."
    
    "Простий, звичний ритуал."
    
    "Вона справді гарна. І здається доброю."
    "Може, сказати їй щось? Нічого ж від цього не зміниться, а їй буде приємно."
    
    cashier "З вас 156 гривень."
    
    "Подаю гроші. Вона дає решту й чек."
    
    cashier "Дякую за покупку. До побачення!"
    
    "Момент відповіді. Простий жест ввічливості."
    
    menu:
        "Промовчати й піти":
            $ dec_mood(1)
            $ reaction = "silent"
        "Відповісти ввічливо":
            $ inc_mood(1)
            $ reaction = "polite"
        "Зробити комплімент зачісці":
            $ inc_mood(3)
            $ reaction = "compliment"
    
    whisper "Дякую. У вас дуже гарна зачіска. Гарного дня!"
    
    "Дівчина трохи здивовано піднімає брови, але посміхається щиріше."
    
    cashier "Ох... дякую! І вам гарного дня."
    
    hide cashier with dissolve
    scene street with fade
    
    "Виходжу з магазину з пакетом в руках."
    
    if reaction == "silent":
        gg "Я просто хотів піти мовчки."
        whisper "Та я бачив, як ти дивився на неї увесь час."
        gg "Це не означає, що треба було щось казати."
        whisper "Чому ні? Вона посміхнулася. Їй було приємно."
        gg "Бо... Бо не хотів!"
        whisper "Ти хотів, просто боявся."
        gg "Що якби подумала, що я дивний?"
        whisper "А тепер думає, що ти приємний. Хіба так не краще?"

    elif reaction == "polite":
        gg "Тобі не здається, що це було занадто? Я ж просто хотів побажати гарного дня."
        whisper "Ні, це було якраз доречно. Ти бачив її посмішку."
        gg "Можливо... Але ж я хотів просто сказати 'до побачення'."
        whisper "А я сказав те, про що ти думав увесь час."
        gg "Не весь час..."
        whisper "Добре, половину. Ти ж розглядав її зачіску, поки вона сканувала молоко."
        gg "Це було аж так помітно?"
        whisper "Тільки мені. Тому я й озвучив."

    elif reaction == "compliment":
        gg "Саме те, що хотів сказати."
        whisper "Бачиш? Іноді ми думаємо однаково."
        gg "Звучало трохи прямо."
        whisper "Щиро. Це називається щиро."
        gg "А якби подумала, що я підкатую?"
        whisper "Комплімент зачісці — не освідчення."
        gg "Я не звик так говорити."
        whisper "Тому я тут — щоб ти почав."
    
    "..."
    gg "В будь якому випадку. Ти завжди будеш казати те, що я \"насправді\" думаю?"
    whisper "Тільки те, що боїшся сказати. Це більшість думок у твоїй голові."
    gg "Це може спричинити проблеми."
    whisper "Або вирішити їх. Побачимо."
    
    return
